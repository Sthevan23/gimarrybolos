# Gimarry Bolos — site estático leve

Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Fotos originais pesadas: só miniaturas (_thumbs)
  RewriteCond %{REQUEST_URI} ^/fotos_bolos/ [NC]
  RewriteCond %{REQUEST_URI} !^/fotos_bolos/_thumbs/ [NC]
  RewriteRule .* - [F,L]

  # Bots / scrapers (cada hit = processo na Hostinger)
  RewriteCond %{HTTP_USER_AGENT} (AhrefsBot|SemrushBot|DotBot|MJ12bot|Bytespider|PetalBot|ClaudeBot|GPTBot|CCBot|DataForSeo|BLEXBot|Zoominfo|Scrapy|Amazonbot|meta-externalagent|FacebookBot|ImagesiftBot|magpie-crawler|masscan|nikto|sqlmap|python-requests|Go-http-client) [NC]
  RewriteRule .* - [F,L]
</IfModule>

<IfModule mod_headers.c>
  Header unset ETag
  FileETag None

  <FilesMatch "\.(?i:jpe?g|png|gif|webp|svg|ico|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(?i:css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.(?i:html?)$">
    Header set Cache-Control "public, max-age=300"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType text/html "access plus 5 minutes"
</IfModule>
