# Gimarry Bolos — cache, segurança e modo OFF

# ---- MODO OFF (arquivo SITE_OFF na raiz) ----
# Com SITE_OFF presente: site, admin e API ficam desligados (página leve).
# Para LIGAR de novo: apague o arquivo SITE_OFF no File Manager.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Se SITE_OFF existir, tudo vai para offline.html (exceto a própria página)
  RewriteCond %{DOCUMENT_ROOT}/SITE_OFF -f
  RewriteCond %{REQUEST_URI} !/offline\.html$ [NC]
  RewriteRule ^ offline.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Imagens: 30 dias
  <FilesMatch "\.(?i:jpe?g|png|gif|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000, immutable"
  </FilesMatch>

  # CSS/JS versionados com ?v=: 30 dias
  <FilesMatch "\.(?i:css|js)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # HTML: revalida sempre
  <FilesMatch "\.(?i:html?)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Bloqueia pastas sensíveis se forem publicadas por engano
RedirectMatch 404 (?i)/(backend|node_modules|\.git|docs)/
