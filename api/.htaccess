# data.json privado; catalog.json público e cacheável
<Files "data.json">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</Files>

<Files "catalog.json">
  <IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=300"
    Header set Access-Control-Allow-Origin "*"
  </IfModule>
</Files>
